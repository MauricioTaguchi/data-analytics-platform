# Install as /etc/dataflow/backup.env with owner root and mode 0600.
# systemd EnvironmentFile syntax: values only; this file is never sourced.
DATAFLOW_PROJECT_DIR=/srv/dataflow
DATAFLOW_BACKUP_DIR=/var/backups/dataflow
DATAFLOW_BACKUP_ENV_FILE=/etc/dataflow/backup.env
DATAFLOW_BACKUP_LOCK_FILE=/run/lock/dataflow-backup.lock
# Optional off-host archives. Supply provider credentials through protected
# environment configuration or the dedicated runner's provider identity.
# DATAFLOW_BACKUP_S3_BUCKET=private-dataflow-backups
# DATAFLOW_BACKUP_S3_PREFIX=dataflow-backups
# DATAFLOW_BACKUP_S3_ENDPOINT=https://object-storage.example.com
# AWS_DEFAULT_REGION=us-east-1
# BACKUP_KMS_KEY_ID=alias/dataflow-backups
