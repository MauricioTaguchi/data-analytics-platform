APP_NAME=Data Analytics Platform
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
DATABASE_URL=postgresql+psycopg2://analytics:analytics@db:5432/analytics
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=data/uploads
REPORT_DIR=data/reports
MAX_FILE_SIZE_MB=50
MAX_DATASET_ROWS=1000000
UPLOAD_CHUNK_SIZE_MB=1
STORAGE_BACKEND=local
CORS_ORIGINS=["http://localhost:5173"]
TRUST_PROXY_HEADERS=false
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
CELERY_WORKER_MAX_MEMORY_KB=524288
CELERY_WORKER_MAX_TASKS=50
