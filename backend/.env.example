APP_NAME=Data Analytics Platform
ENVIRONMENT=development
SECRET_KEY=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
DATABASE_URL=postgresql+psycopg2://analytics:analytics@db:5432/analytics
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=data/uploads
REPORT_DIR=data/reports
MAX_FILE_SIZE_MB=50
UPLOAD_MULTIPART_OVERHEAD_MB=2
MAX_CONCURRENT_UPLOAD_REQUESTS=2
MAX_REQUEST_BODY_SIZE_MB=1
MAX_DATASET_ROWS=1000000
MAX_DATASET_COLUMNS=1000
MAX_DATASET_COLUMN_NAME_CHARS=256
UPLOAD_CHUNK_SIZE_MB=1
USER_STORAGE_QUOTA_MB=500
MAX_ACTIVE_JOBS_PER_USER=5
UPLOAD_RATE_LIMIT_MAX_ATTEMPTS=10
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
MIN_FREE_DISK_SPACE_MB=512
MAX_DATASET_EXPANDED_SIZE_MB=512
MAX_DATASET_EXPANSION_RATIO=100
MAX_XLSX_ARCHIVE_ENTRIES=10000
MAX_PROFILE_CORRELATION_COLUMNS=50
TRANSFORMATION_PREVIEW_MAX_COLUMNS=100
TRANSFORMATION_PREVIEW_MAX_CELL_CHARS=512
MAX_JOB_RESULT_SIZE_MB=2
MAX_REPORT_SIZE_MB=10
STORAGE_BACKEND=local
CORS_ORIGINS=["http://localhost:5173"]
TRUST_PROXY_HEADERS=false
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
CELERY_WORKER_MAX_MEMORY_KB=524288
CELERY_WORKER_MAX_TASKS=50
CELERY_WORKER_CONCURRENCY=2
REFRESH_SESSION_CLEANUP_BATCH_SIZE=1000
OUTBOX_DISPATCH_BATCH_SIZE=100
OUTBOX_CLAIM_TTL_SECONDS=120
OUTBOX_MAX_RETRY_SECONDS=300
JOB_RETENTION_DAYS=30
JOB_RETENTION_BATCH_SIZE=1000
